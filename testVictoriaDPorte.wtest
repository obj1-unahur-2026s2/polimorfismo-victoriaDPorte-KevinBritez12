import atletas.*
import elementos.*
import disciplinas.*

describe "Casos de prueba de Victoria D. Porte" {

	test "Victoria cambia a judo, ajusta su altura a 150 cm y usa un judogi" {
		victoria.cambiarDisciplina(judo)
		victoria.cambiarAltura(150)
		victoria.cambiarElemento(judogi)

		assert.equals(225, judogi.costoElemento(victoria))
		assert.equals(245, victoria.presupuestoPropio())
		assert.equals(120, judo.presupuestoDisciplina(victoria))
		assert.equals(365, victoria.presupuesto())
	}
	test "Victoria ahora se quiere parecer a Delpo y empieza a practicar tenis. Elonga con intensidad hasta llegar a los dos metros diez, necesita una raqueta y tiene dos entrenadores" {
		victoria.cambiarDisciplina(tenis)
		victoria.cambiarAltura(210)
		victoria.cambiarElemento(raqueta)
		tenis.cambiarEntrenadores(2)

		assert.equals(345, raqueta.costoElemento(victoria))
	    assert.equals(215, tenis.presupuestoDisciplina(victoria))
	    assert.equals(580, victoria.presupuesto())
	}
}